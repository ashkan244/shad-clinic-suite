# --- Local development (docker compose up -d) ---
DATABASE_URL="postgresql://shad:shad@localhost:5432/shad_clinic?schema=public"
JWT_SECRET="replace-me-in-production"
PORT=4000
WEB_PORT=5173
REDIS_URL="redis://localhost:6379"

# --- Production only (docker-compose.prod.yml reads these from .env) ---
# POSTGRES_PASSWORD=   # openssl rand -hex 24
# JWT_SECRET=          # openssl rand -hex 32  (the API refuses to start in production without a strong one)
# SEED_PASSWORD=       # password for demo accounts created by `npm run seed` (min 8 chars)

# --- Providers ---
SMS_PROVIDER="mock"        # mock | kavenegar
SMS_API_KEY=""
SMS_SENDER=""
PAYMENT_PROVIDER="mock"    # mock | zarinpal
ZARINPAL_MERCHANT_ID=""
PAYMENT_CALLBACK_URL="http://localhost:5173/payment/callback"
