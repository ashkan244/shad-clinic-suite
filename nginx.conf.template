server {
  listen 80;
  server_name _;
  root /usr/share/nginx/html;
  index index.html;

  # $proxy_host (the upstream's own host) is sent as Host so this also works when
  # API_UPSTREAM is another hosted app routed by hostname (e.g. on Liara).
  location /api/ {
    proxy_pass ${API_UPSTREAM}/api/;
    proxy_http_version 1.1;
    proxy_ssl_server_name on;
    proxy_set_header Host $proxy_host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    client_max_body_size 6m;
  }

  # Uploaded medical-record images are served by the API.
  location /uploads/ {
    proxy_pass ${API_UPSTREAM}/uploads/;
    proxy_http_version 1.1;
    proxy_ssl_server_name on;
    proxy_set_header Host $proxy_host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    client_max_body_size 6m;
  }

  location / {
    try_files $uri $uri/ /index.html;
  }
}
